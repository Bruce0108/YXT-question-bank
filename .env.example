# Cloudflare R2 存储配置（云端模式必填，全部填写后程序自动使用 R2 存储）
# 本地开发留空，数据将存储在 uploads/ 目录

# Cloudflare R2 存储桶名称（如: pdf-tool-library）
R2_BUCKET_NAME=

# Cloudflare Account ID（在 Cloudflare 控制台右侧可找到）
R2_ACCOUNT_ID=

# R2 API Token 的 Access Key ID（在 R2 > Manage API tokens 中创建）
R2_ACCESS_KEY_ID=

# R2 API Token 的 Secret Access Key
R2_SECRET_ACCESS_KEY=

# 本地临时文件目录（可选，默认 /tmp/pdf_uploads）
# LOCAL_TMP_DIR=/tmp/pdf_uploads
